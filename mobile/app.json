{
  "expo": {
    "main": "expo-router/entry",
    "name": "SnapTip",
    "slug": "snaptip",
    "owner": "hittedevv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/snaptip_icon.png",
    "scheme": "snaptip",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/snaptip_icon.png",
      "backgroundColor": "#080818",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.snaptip.app",
      "icon": "./assets/images/snaptip_icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapTip needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "SnapTip needs photo library access to select profile photos.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "snaptip.me": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/snaptip_icon.png",
        "backgroundColor": "#080818"
      },
      "package": "me.snaptip.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/snaptip_icon.png",
          "color": "#00C896",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/notification.mp3",
            "./assets/sounds/tip_received.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapTip needs photo library access to select profile photos.",
          "cameraPermission": "SnapTip needs camera access to take profile photos."
        }
      ],
      "expo-web-browser",
      "expo-av",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d53512d7-5a91-49c2-8a37-764e896bbcac"
      }
    }
  }
}
