{
  "expo": {
    "main": "expo-router/entry",
    "name": "SnapTip",
    "slug": "snaptip",
    "owner": "hittedevv",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/snaptip_icon.png",
    "scheme": "snaptip",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/snaptip_icon.png",
      "backgroundColor": "#1a1a1a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.snaptip.app",
      "buildNumber": "1.0.0",
      "icon": "./assets/images/snaptip_icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapTip needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "SnapTip needs photo library access to select profile photos.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "snaptip.me": {
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:snaptip.me"
      ]
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "barStyle": "light-content",
        "backgroundColor": "#00000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/snaptip_icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "package": "me.snaptip.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "snaptip.me",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "snaptip",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/snaptip_icon.png",
          "color": "#00C896",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/notification.mp3",
            "./assets/sounds/tip_received.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SnapTip needs photo library access to select profile photos.",
          "cameraPermission": "SnapTip needs camera access to take profile photos."
        }
      ],
      "expo-web-browser",
      "expo-av",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d53512d7-5a91-49c2-8a37-764e896bbcac"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d53512d7-5a91-49c2-8a37-764e896bbcac"
    }
  }
}
