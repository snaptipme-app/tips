# SnapTip server environment variables
# Copy this file to .env and fill in the values.
# In production, generate strong secrets with:  openssl rand -base64 64

# ── Runtime ──
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://user:password@localhost:5432/snaptip

# ── JWT (employee tokens) ──
# REQUIRED. Use a 64+ char random string. Rotating this invalidates all sessions.
JWT_SECRET=your_super_secret_jwt_key_here

# ── Admin Portal ──
ADMIN_PASSWORD=snaptip_admin_2024
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# ── Cookies ──
# Used to sign session/refresh-token cookies. Generate with `openssl rand -base64 64`.
COOKIE_SECRET=replace_with_64_char_random_string

# ── Field-level encryption (pgcrypto) ──
# Encrypts withdrawal account_details (IBAN/RIB/wallet) at rest via pgp_sym_encrypt.
# If absent, the app falls back to plaintext writes (deploys never break) but logs
# a warning. Generate with `openssl rand -base64 48 | tr -d '\n'`. Backfill existing
# plaintext rows with `node server/scripts/encrypt-legacy-withdrawals.js`.
DATA_ENCRYPTION_KEY=replace_with_48_char_random_string

# ── CORS allowlist ──
# Comma-separated origins allowed to call the API. Defaults to snaptip.me + www.
CORS_ORIGINS=https://snaptip.me,https://www.snaptip.me

# ── SMTP — withdrawal & OTP email ──
# Gmail: enable 2FA and use an App Password. Brevo: paste the SMTP relay key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
